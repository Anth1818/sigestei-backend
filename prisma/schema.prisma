generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") 
}

// Tabla genérica para equipos (computadoras, impresoras, etc.)
model equipment {
  id               Int                 @id @default(autoincrement())
  asset_number     String              @unique @db.VarChar(100)
  serial_number    String              @unique @db.VarChar(255)
  model            String?             @db.VarChar(255)
  location         String?             @db.VarChar(255)
  type_id          Int                 // 1=PC, 2=Laptop, 3=Printer, etc.
  brand_id         Int
  status_id        Int
  department_id    Int?                // Para equipos departamentales (impresoras)
  assigned_user_id Int?                // NULL para impresoras, valor para computadoras personales
  specifications   Json?               // Specs flexibles: hardware, software, printer specs, etc.
  
  equipment_types    equipment_types    @relation(fields: [type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  equipment_brands   equipment_brands   @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  equipment_statuses equipment_statuses @relation(fields: [status_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departments        departments?       @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users              users?             @relation(fields: [assigned_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requests           requests[]
  equipment_assignments equipment_assignments[]
}

model departments {
  id        Int         @id @default(autoincrement())
  name      String      @unique @db.VarChar(100)
  equipment equipment[] // Equipos departamentales (ej: impresoras)
  positions positions[]
  users     users[]
}

model equipment_brands {
  id        Int         @id @default(autoincrement())
  name      String      @unique @db.VarChar(50)
  equipment equipment[]
}

model equipment_statuses {
  id        Int         @id @default(autoincrement())
  name      String      @unique @db.VarChar(50)
  equipment equipment[]
}

model equipment_types {
  id                     Int                     @id @default(autoincrement())
  name                   String                  @unique @db.VarChar(50)
  equipment              equipment[]
  requests_type_equipment requests[]            @relation("requests_type_equipment")
}

model genders {
  id    Int     @id @default(autoincrement())
  name  String  @unique @db.VarChar(50)
  users users[]
}

model positions {
  id            Int          @id @default(autoincrement())
  name          String       @db.VarChar(100)
  department_id Int?
  departments   departments? @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users         users[]
}

model request_priorities {
  id       Int        @id @default(autoincrement())
  name     String     @unique @db.VarChar(50)
  requests requests[]
}

model request_statuses {
  id       Int        @id @default(autoincrement())
  name     String     @unique @db.VarChar(50)
  requests requests[]
}

model request_types {
  id       Int        @id @default(autoincrement())
  name     String     @unique @db.VarChar(50)
  requests requests[]
}

model os_options {
  id                 Int                  @id @default(autoincrement())
  name               String               @unique @db.VarChar(50)
}

model office_suites {
  id                 Int                  @id @default(autoincrement())
  name               String               @unique @db.VarChar(50)
}

model antivirus_solutions {
  id                 Int                  @id @default(autoincrement())
  name               String               @unique @db.VarChar(50)
}

model requests {
  id                                   Int                    @id @default(autoincrement())
  description                          String
  request_date                         DateTime?              @default(now()) @db.Timestamptz(6)
  resolution_date                      DateTime?              @db.Timestamptz(6)
  comments_technician                  String?
  requester_id                         Int
  beneficiary_id                       Int?
  technician_id                        Int?
  equipment_id                         Int?                   // Equipo asociado al request
  type_equipment_id                    Int?                   // Tipo de equipo del request
  type_id                              Int
  status_id                            Int
  priority_id                          Int
  
  users_requests_beneficiary_idTousers users?                 @relation("requests_beneficiary_idTousers", fields: [beneficiary_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  equipment                            equipment?             @relation(fields: [equipment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  equipment_type                       equipment_types?       @relation("requests_type_equipment", fields: [type_equipment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  request_priorities                   request_priorities     @relation(fields: [priority_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_requests_requester_idTousers   users                  @relation("requests_requester_idTousers", fields: [requester_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  request_statuses                     request_statuses       @relation(fields: [status_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_requests_technician_idTousers  users?                 @relation("requests_technician_idTousers", fields: [technician_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  request_types                        request_types          @relation(fields: [type_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  request_history                      request_history[]
  technician_assignments               request_technician_assignments[]
}

model request_history {
  id             Int       @id @default(autoincrement())
  request_id     Int
  change_type    String    @db.VarChar(50) // 'priority', 'status', 'technician_assigned', 'technician_reassigned'
  old_value      String?   @db.VarChar(255)
  new_value      String?   @db.VarChar(255)
  changed_by_id  Int?      // Usuario que hizo el cambio
  changed_at     DateTime  @default(now()) @db.Timestamptz(6)
  comments       String?   // Comentarios sobre el cambio
  
  requests       requests  @relation(fields: [request_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  changed_by     users?    @relation("request_history_changed_by", fields: [changed_by_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  
  @@index([request_id])
  @@index([change_type])
  @@index([changed_at])
}

// Auditoría específica para asignaciones de técnicos a solicitudes
model request_technician_assignments {
  id                    Int       @id @default(autoincrement())
  request_id            Int
  technician_id         Int?      // NULL si se desasigna
  previous_technician_id Int?
  assigned_by_id        Int
  assigned_at           DateTime  @default(now()) @db.Timestamptz(6)
  reason                String?   // Motivo de asignación/reasignación
  
  requests              requests  @relation(fields: [request_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  technician            users?    @relation("assignment_technician", fields: [technician_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  previous_technician   users?    @relation("assignment_previous_technician", fields: [previous_technician_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  assigned_by           users     @relation("assignment_assigned_by", fields: [assigned_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  @@index([request_id])
  @@index([technician_id])
  @@index([assigned_at])
}

// Auditoría para asignaciones de equipos a usuarios y cambios de ubicación
model equipment_assignments {
  id                  Int       @id @default(autoincrement())
  equipment_id        Int
  user_id             Int?      // NULL si se desasigna
  previous_user_id    Int?
  location            String?   @db.VarChar(255)
  previous_location   String?   @db.VarChar(255)
  assigned_by_id      Int
  assigned_at         DateTime  @default(now()) @db.Timestamptz(6)
  reason              String?
  
  equipment           equipment @relation(fields: [equipment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user                users?    @relation("equipment_assignment_user", fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  previous_user       users?    @relation("equipment_assignment_previous_user", fields: [previous_user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  assigned_by         users     @relation("equipment_assignment_assigned_by", fields: [assigned_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  @@index([equipment_id])
  @@index([user_id])
  @@index([assigned_at])
}

// Auditoría para logins de usuarios
model user_logins {
  id            Int       @id @default(autoincrement())
  user_id       Int
  login_at      DateTime  @default(now()) @db.Timestamptz(6)
  ip_address    String?   @db.VarChar(45)
  user_agent    String?
  success       Boolean   @default(true)
  failure_reason String?  // Si success = false
  
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  
  @@index([user_id])
  @@index([login_at])
}

// Auditoría genérica para cambios en requests, equipment y users
model audit_log {
  id             Int       @id @default(autoincrement())
  entity_type    String    @db.VarChar(50) // 'request', 'equipment', 'user'
  entity_id      Int       // ID del registro afectado
  change_type    String    @db.VarChar(50) // 'status', 'priority', 'profile_updated', etc.
  field_name     String?   @db.VarChar(100) // Campo específico modificado
  old_value      String?   @db.VarChar(500)
  new_value      String?   @db.VarChar(500)
  changed_by_id  Int?
  changed_at     DateTime  @default(now()) @db.Timestamptz(6)
  comments       String?
  
  changed_by     users?    @relation(fields: [changed_by_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  
  @@index([entity_type, entity_id])
  @@index([change_type])
  @@index([changed_at])
  @@index([changed_by_id])
}

model roles {
  id    Int     @id @default(autoincrement())
  name  String  @unique @db.VarChar(50)
  users users[]
}

model users {
  id                                      Int               @id @default(autoincrement())
  full_name                               String            @db.VarChar(255)
  identity_card                           Int               @unique
  email                                   String            @unique @db.VarChar(255)
  password_hash                           String            @db.VarChar(255)
  is_active                               Boolean?          @default(true)
  role_id                                 Int
  position_id                             Int?
  gender_id                               Int?
  department_id                           Int?
  created_at                              DateTime?         @default(now()) @db.Timestamptz(6)
  last_login                              DateTime?         @db.Timestamptz(6)
  last_login_backup                       DateTime?         @db.Timestamptz(6)
  
  equipment                               equipment[]       // Equipos asignados
  requests_requests_beneficiary_idTousers requests[]        @relation("requests_beneficiary_idTousers")
  requests_requests_requester_idTousers   requests[]        @relation("requests_requester_idTousers")
  requests_requests_technician_idTousers  requests[]        @relation("requests_technician_idTousers")
  request_history_changes                 request_history[] @relation("request_history_changed_by")
  departments                             departments?      @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  genders                                 genders?          @relation(fields: [gender_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  positions                               positions?        @relation(fields: [position_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roles                                   roles             @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  // Relaciones de auditoría
  user_logins                                          user_logins[]
  audit_logs                                           audit_log[]
  request_technician_assignments_technician            request_technician_assignments[] @relation("assignment_technician")
  request_technician_assignments_previous_technician   request_technician_assignments[] @relation("assignment_previous_technician")
  request_technician_assignments_assigned_by           request_technician_assignments[] @relation("assignment_assigned_by")
  equipment_assignments_user                           equipment_assignments[] @relation("equipment_assignment_user")
  equipment_assignments_previous_user                  equipment_assignments[] @relation("equipment_assignment_previous_user")
  equipment_assignments_assigned_by                    equipment_assignments[] @relation("equipment_assignment_assigned_by")
}
