# DATABASE CONFIGURATION
# Usar el nombre del servicio de PostgreSQL del docker-compose como host
# Ejemplo: DATABASE_URL="postgresql://usuario:contraseña@postgres:5432/nombre_db?schema=public"
DATABASE_URL="postgresql://postgres:password@postgres:5432/sigestei_db?schema=public"

# PRISMA ACCELERATE (Opcional - solo si usas Prisma Accelerate)
PRISMA_ACCELERATE_URL="prisma+postgres://postgres:password@postgres:5432/sigestei_db"

# APPLICATION CONFIGURATION
NODE_ENV=production
PORT=3001

# JWT CONFIGURATION (si usas autenticación)
# JWT_SECRET=tu_secreto_super_seguro_aqui
# JWT_EXPIRES_IN=7d

# CORS CONFIGURATION (si necesitas configurar CORS)
# ALLOWED_ORIGINS=http://localhost:3000,https://tu-dominio.com
